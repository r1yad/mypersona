<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_accent">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#337C83FF"
                android:endColor="#2938BDF8"
                android:type="linear" />
            <corners android:radius="@dimen/glass_radius_pill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border_accent" />
        </shape>
    </item>
</ripple>
