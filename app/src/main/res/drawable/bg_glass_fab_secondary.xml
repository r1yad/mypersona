<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#EB162038" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_border_bright" />
                </shape>
            </item>
            <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="10dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="@color/glass_sheen_none"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
