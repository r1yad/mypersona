<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:startColor="#EB7C83FF"
                        android:endColor="#EB5558E6"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#80FFFFFF" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="14dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:endColor="@color/glass_sheen_none"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
