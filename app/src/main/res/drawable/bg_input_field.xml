<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#A60D1528" />
            <corners android:radius="@dimen/glass_radius_input" />
            <stroke
                android:width="1.2dp"
                android:color="@color/indigo_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <corners android:radius="@dimen/glass_radius_input" />
            <stroke
                android:width="1dp"
                android:color="@color/border_divider" />
        </shape>
    </item>
</selector>
