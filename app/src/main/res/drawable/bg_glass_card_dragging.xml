<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB1D2847" />
            <corners android:radius="@dimen/glass_radius_panel" />
            <stroke
                android:width="1.5dp"
                android:color="@color/indigo_primary" />
        </shape>
    </item>
    <item
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2E7C83FF"
                android:endColor="@color/glass_sheen_none"
                android:type="linear" />
            <corners android:radius="18.5dp" />
        </shape>
    </item>
</layer-list>
