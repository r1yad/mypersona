<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF1B244B"
                android:centerColor="#FF281E4A"
                android:endColor="#FF0D253F"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.25"
                android:centerY="0.25"
                android:gradientRadius="220dp"
                android:startColor="#407C83FF"
                android:endColor="#001B244B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.82"
                android:centerY="0.45"
                android:gradientRadius="180dp"
                android:startColor="#3338BDF8"
                android:endColor="#000D253F" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="44dp" />
            <gradient
                android:angle="90"
                android:startColor="#CC060913"
                android:endColor="#00060913"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
