<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Frosted Amber Glass Debug Mode Banner -->
    <LinearLayout
        android:id="@+id/layout_debug_mode_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_debug_banner"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/debug_mode_active_banner"
            android:src="@drawable/ic_bug"
            app:tint="@color/amber_warning" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/debug_mode_active_banner"
            android:textColor="@color/amber_warning"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_feed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_debug_mode_banner" />

    <!-- Frosted Glass Empty State Card -->
    <LinearLayout
        android:id="@+id/layout_empty_feed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="460dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_glass_avatar_ring">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/empty_feed_title"
                android:src="@drawable/ic_feed"
                app:tint="@color/indigo_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/empty_feed_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/empty_feed_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_create_persona"
            style="@style/Widget.PersonaNet.GlassButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="24dp"
            android:text="@string/create_persona" />
    </LinearLayout>

    <!-- Floating Liquid Glass Go to Top Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_go_to_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/go_to_top"
        android:src="@drawable/ic_arrow_up"
        android:visibility="gone"
        app:backgroundTint="@color/surface_elevated"
        app:borderWidth="1dp"
        app:elevation="6dp"
        app:fabCustomSize="48dp"
        app:layout_constraintBottom_toTopOf="@id/fab_create_post"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/ripple_accent"
        app:tint="@color/indigo_primary" />

    <!-- Floating Liquid Glass Refresh Feed Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_refresh_feed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/refresh_feed"
        android:src="@drawable/ic_refresh"
        app:backgroundTint="@color/surface_elevated"
        app:borderWidth="1dp"
        app:elevation="6dp"
        app:fabCustomSize="48dp"
        app:layout_constraintBottom_toTopOf="@id/fab_go_to_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/ripple_color"
        app:tint="@color/text_primary" />

    <!-- Primary Floating Liquid Glass Create Post Orb -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:contentDescription="@string/create_post"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/indigo_primary"
        app:borderWidth="1dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/ripple_color"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
