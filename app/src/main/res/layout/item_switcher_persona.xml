<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_switcher_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_switcher_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@color/surface_elevated"
        android:contentDescription="@string/app_name"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PersonaNet.Circle"
        app:strokeColor="@color/glass_border_bright"
        app:strokeWidth="1.5dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_switcher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_switcher_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/indigo_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_switcher_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_active_persona_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="@string/active_badge"
        android:textColor="@color/emerald_success"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btn_switcher_profile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="View Profile"
        android:padding="12dp"
        android:src="@drawable/ic_personas"
        app:tint="@color/text_secondary" />

</LinearLayout>
