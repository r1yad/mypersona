<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_ambient_canvas">

    <!-- Translucent Frosted Liquid Glass Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_chrome_bar"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chip_active_persona"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Frosted Active Persona Switcher Pill -->
        <LinearLayout
            android:id="@+id/chip_active_persona"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_active_persona_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="210dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_active_persona_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@color/surface_elevated"
                android:contentDescription="@string/app_name"
                android:padding="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PersonaNet.Circle"
                app:strokeColor="@color/glass_border_bright"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/text_active_persona_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="128dp"
                android:text="@string/no_active_persona"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/select_active_persona"
                android:src="@drawable/ic_swap"
                app:tint="@color/indigo_primary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- Frosted Liquid Glass Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bottom_nav"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        app:backgroundTint="@null"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.PersonaNet.BottomNavIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemPaddingBottom="8dp"
        app:itemPaddingTop="8dp"
        app:itemRippleColor="@color/ripple_accent"
        app:itemTextColor="@color/selector_nav_text"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
